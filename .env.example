PORT=3000
# Chave do painel/rotas protegidas. Gere uma forte: openssl rand -hex 24
API_KEY=troque-esta-chave-por-uma-forte
# Sites autorizados a enviar formulários (separe por vírgula) ou * para todos
CORS_ORIGIN=*
# (Opcional) Webhook de Slack/Discord/Zapier/Make: recebe um aviso a cada novo lead
WEBHOOK_URL=
# Máx. de envios de formulário por minuto por IP
RATE_LIMIT=10
# Caminho do banco SQLite (em hospedagem com volume, aponte para o volume)
DB_PATH=./data/leads.db
